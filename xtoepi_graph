import numpy as np
import networkx as nx
from eer import EpistemicGraph

G_nx = nx.barabasi_albert_graph(500, m=3, seed=0)

g = EpistemicGraph(num_nodes=G_nx.number_of_nodes())
g.b = np.random.uniform(0.0, 1.0, size=g.num_nodes)
g.lambda_vec = np.random.uniform(0.5, 2.0, size=g.num_nodes)

for u, v in G_nx.edges():
    g.add_support_edge(int(u), int(v), 1.0)

# Optional: add derived-from edges (directed)
rng = np.random.default_rng(0)
edges = list(G_nx.edges())
for idx in rng.choice(len(edges), size=len(edges) // 10, replace=False):
    u, v = edges[idx]
    g.add_derived_from_edge(int(u), int(v), 0.5)
