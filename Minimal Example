import networkx as nx
import numpy as np
from eer import (
    EpistemicGraph,
    assemble_extended_hessian,
    build_cycle_matrix_fundamental,
    run_hybrid_priority_scheduler_optimized,
)

# Build graph
G_nx = nx.barabasi_albert_graph(500, m=3, seed=0)
g = EpistemicGraph(num_nodes=500)
g.b = np.random.uniform(0, 1, size=500)
for u, v in G_nx.edges():
    g.add_support_edge(int(u), int(v), 1.0)

# Assemble Hessian
Q_cyc = build_cycle_matrix_fundamental(g)
H = assemble_extended_hessian(g, gamma=0.05, Q_cycle=Q_cyc)
H_csr, H_csc = H.tocsr(), H.tocsc()

# Solve
x0 = np.full(500, 0.5)
x, updates, res = run_hybrid_priority_scheduler_optimized(
    H_csr.indptr, H_csr.indices, H_csr.data,
    H_csc.indptr, H_csc.indices, H_csc.data,
    g.b, x0, M=500, epsilon=1e-3, tol=1e-6,
)
print(f"updates = {updates}, residual = {res:.2e}")
