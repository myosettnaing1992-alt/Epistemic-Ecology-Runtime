# ============================================================
# EER Repository .gitignore
# Epistemic Ecology Runtime
# https://github.com/myosettnaing1992-alt/Epistemic-Ecology-Runtime
# ============================================================

# ------------------------------------------------------------
# Python — Bytecode & Caches
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.c
*.cpp
*.o
*.obj

# ------------------------------------------------------------
# Python — Packaging & Distribution
# ------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------
# Python — Testing & Coverage
# ------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ------------------------------------------------------------
# Python — Virtual Environments
# ------------------------------------------------------------
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.conda/

# ------------------------------------------------------------
# Python — Type Checkers & Linters
# ------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/
.pytype/

# ------------------------------------------------------------
# Python — Jupyter
# ------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ------------------------------------------------------------
# Numba — JIT Compilation Cache
# ------------------------------------------------------------
__pycache__/*.nbi
__pycache__/*.nbc
*.nbi
*.nbc
.numba_cache/

# ------------------------------------------------------------
# EER — Results (root results/ directory)
# ------------------------------------------------------------
results/*.json
results/*.csv
results/*.md
results/*.pkl
results/*.npz
results/*.npy
results/*.log
results/*.txt
results/*.html
!results/.gitkeep
!results/README.md

# ------------------------------------------------------------
# EER — Figures (root figures/ directory)
# ------------------------------------------------------------
figures/*.pdf
figures/*.png
figures/*.svg
figures/*.eps
figures/*.jpg
figures/*.jpeg
figures/*.tiff
figures/*.ps
!figures/.gitkeep
!figures/README.md

# ------------------------------------------------------------
# EER — Data (root data/ directory)
# ------------------------------------------------------------
data/*.graphml
data/*.gml
data/*.gexf
data/*.edgelist
data/*.adjlist
data/*.mtx
data/*.npz
data/*.npy
data/*.h5
data/*.hdf5
data/*.pkl
data/*.pickle
data/*.json
!data/.gitkeep
!data/README.md

# ------------------------------------------------------------
# EER — Benchmark Results (benchmarks/results/)
# ------------------------------------------------------------
benchmarks/results/*.json
benchmarks/results/*.csv
benchmarks/results/*.md
benchmarks/results/*.pkl
benchmarks/results/*.npz
!benchmarks/results/.gitkeep
!benchmarks/results/README.md
!benchmarks/results/sample_benchmark.json
!benchmarks/results/sample_benchmark.md

# ------------------------------------------------------------
# EER — Experiment Outputs (experiments/ directory)
# ------------------------------------------------------------
experiments/output/
experiments/outputs/
experiments/results/
experiments/*.log
experiments/logs/
*.svg
*.pdf

# ------------------------------------------------------------
# EER — Calibration Checkpoints
# ------------------------------------------------------------
checkpoints/
calibration/
*.ckpt
*.pth
*.pt
*.h5
*.hdf5

