# ============================================================
# EER Repository .gitignore
# Epistemic Ecology Runtime
# ============================================================

# ------------------------------------------------------------
# Python — Bytecode & Caches
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.c
*.cpp
*.o
*.obj

# ------------------------------------------------------------
# Python — Packaging & Distribution
# ------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------
# Python — Unit Test / Coverage
# ------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ------------------------------------------------------------
# Python — Virtual Environments
# ------------------------------------------------------------
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.conda/

# ------------------------------------------------------------
# Python — Type Checkers & Linters
# ------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/
.pytype/

# ------------------------------------------------------------
# Python — Jupyter Notebooks
# ------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ------------------------------------------------------------
# Numba — JIT Compilation Cache
# ------------------------------------------------------------
__pycache__/*.nbi
__pycache__/*.nbc
*.nbi
*.nbc
.numba_cache/

# ------------------------------------------------------------
# EER — Experiment Results
# (Uncomment the ones you do NOT want to commit)
# ------------------------------------------------------------
results/*.json
results/*.csv
results/*.pkl
results/*.h5
results/*.npz
results/*.npy
results/*.log
results/*.txt
!results/.gitkeep
!results/README.md

# ------------------------------------------------------------
# EER — Generated Figures
# (PDF/PNG figures regenerated by experiment scripts)
# ------------------------------------------------------------
figures/*.pdf
figures/*.png
figures/*.svg
figures/*.eps
!figures/.gitkeep
!figures/README.md

# ------------------------------------------------------------
# EER — Calibration & Checkpoints
# ------------------------------------------------------------
checkpoints/
calibration/
*.ckpt
*.pth
*.pt
*.h5
*.hdf5

# ------------------------------------------------------------
# EER — Large Graph Data
# (Prevent accidentally committing 100MB+ graph files)
# ------------------------------------------------------------
data/*.graphml
data/*.gml
data/*.gexf
data/*.edgelist
data/*.adjlist
data/*.mtx
data/*.npz
!data/.gitkeep
!data/README.md
!data/small_example.graphml

# ------------------------------------------------------------
# LaTeX — Paper Build Artifacts
# (If you keep the paper in the same repo)
# ------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
paper.pdf
paper/*.pdf
!paper/figures/*.pdf

# ------------------------------------------------------------
# IDE & Editors
# ------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json.example
!.vscode/launch.json.example

# PyCharm / IntelliJ
.idea/
*.iml
*.iws

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# Sublime
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------
# Operating Systems
# ------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ------------------------------------------------------------
# Environment & Secrets
# ------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
secrets.yaml
secrets.yml
config_local.yaml
config_local.yml

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
*.bak
*.tmp
*.temp
*.orig
*.rej
tmp/
temp/
scratch/

# Benchmark outputs

benchmarks/results/*.json
benchmarks/results/*.csv
benchmarks/results/*.md
!benchmarks/results/sample_benchmark.json
!benchmarks/results/sample_benchmark.md
!benchmarks/results/README.md
!benchmarks/results/.gitkeep
