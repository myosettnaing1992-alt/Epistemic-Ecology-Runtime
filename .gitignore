# ============================================================
# EER Repository .gitignore
# ============================================================

# Python — Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Python — Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python — Testing & Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Python — Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.conda/

# Python — Type Checkers & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/
.pytype/

# Python — Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Numba — JIT Cache
__pycache__/*.nbi
__pycache__/*.nbc
*.nbi
*.nbc
.numba_cache/

# EER — Experiment Results
benchmarks/results/*.json
benchmarks/results/*.csv
benchmarks/results/*.md
!benchmarks/results/sample_benchmark.json
!benchmarks/results/sample_benchmark.md
!benchmarks/results/README.md
!benchmarks/results/.gitkeep

results/*.json
results/*.csv
results/*.pkl
results/*.npz
results/*.npy
results/*.log
!results/.gitkeep
!results/README.md

# EER — Figures
figures/*.pdf
figures/*.png
figures/*.svg
figures/*.eps
!figures/.gitkeep

# EER — Checkpoints
checkpoints/
calibration/
*.ckpt
*.pth
*.pt

# EER — Large Graph Data
data/*.graphml
data/*.gml
data/*.gexf
data/*.edgelist
data/*.adjlist
data/*.mtx
data/*.npz
!data/.gitkeep
!data/README.md

# LaTeX
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
paper.pdf
!paper/figures/*.pdf

# IDE
.vscode/
!.vscode/settings.json.example
!.vscode/launch.json.example
.idea/
*.iml
*.iws
*.swp
*.swo
*~
.vim/
\#*\#
.\#*
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*

# Environment & Secrets
.env
.env.local
.env.*.local
*.env
secrets.yaml
secrets.yml
config_local.yaml
config_local.yml

# Misc
*.bak
*.tmp
*.temp
*.orig
*.rej
tmp/
temp/
scratch/
